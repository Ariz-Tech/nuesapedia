# PostgreSQL Connection String
# Leave empty ("") in local development to use the built-in in-memory store without PostgreSQL,
# or set a running local/cloud PostgreSQL URL (required in production):
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nuesapedia"
DATABASE_URL=""
# Set SKIP_SCHEMA_ENSURE="true" in production after running `npm run db:migrate`
SKIP_SCHEMA_ENSURE="false"

# Session Security Secret (Must be high-entropy 32+ characters in production)
SESSION_SECRET="generate_a_random_64_character_hex_or_base64_secret_here"

# Canonical Public App Origin (Used for password reset links)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Transactional Email for Tokenized Password Resets (Resend HTTP API)
RESEND_API_KEY=""
EMAIL_FROM="NUESApedia <noreply@nuesapedia.fuoye.edu.ng>"

# Cloudflare R2 Object Storage (Zero Egress S3-Compatible Storage)
R2_ACCOUNT_ID="your_cloudflare_account_id"
R2_ACCESS_KEY_ID="your_r2_access_key_id"
R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
R2_BUCKET_NAME="nuesapedia-storage"
R2_PUBLIC_URL="" # Leave empty to keep bucket private and serve short-lived signed URLs via /api/resources/:id/view

# RBAC Initial Admin Accounts (Comma-separated emails synced to PostgreSQL role='ADMIN')
ADMIN_EMAILS="admin@fuoye.edu.ng"
