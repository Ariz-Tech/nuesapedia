# PostgreSQL Connection String
# Leave empty ("") in local development to use the built-in in-memory store without PostgreSQL,
# or set a running local/cloud PostgreSQL URL (required in production):
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nuesapedia"
# Managed providers (Aiven/Neon/RDS/Supabase): use "?sslmode=require&uselibpqcompat=true" to avoid
# a "self-signed certificate in certificate chain" error (this pg version treats "require" as "verify-full").
DATABASE_URL=""
# Set SKIP_SCHEMA_ENSURE="true" in production after running `npm run db:migrate`
SKIP_SCHEMA_ENSURE="false"

# Session Security Secret (Must be high-entropy 32+ characters in production)
SESSION_SECRET="generate_a_random_64_character_hex_or_base64_secret_here"

# Scheduled Maintenance / Worker Cron Authorization Secret (Must be set in production)
CRON_SECRET="generate_a_random_32_character_hex_or_base64_cron_secret_here"

# Canonical Public App Origin (Used to build password reset links; required in production)
APP_URL="http://localhost:3000"

# Transactional Email for Password Resets & Moderation Updates (Resend HTTP API)
RESEND_API_KEY=""
EMAIL_FROM="The NUESA Library <noreply@nuesalibrary.fuoye.edu.ng>"
# Optional comma-separated moderator emails alerted when new submissions enter review
MODERATOR_ALERT_EMAILS=""

# Cloudflare R2 Object Storage (Zero Egress S3-Compatible Storage)
R2_ACCOUNT_ID="your_cloudflare_account_id"
R2_ACCESS_KEY_ID="your_r2_access_key_id"
R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
R2_BUCKET_NAME="nuesapedia-storage"
R2_PUBLIC_URL="" # Leave empty to keep bucket private and serve short-lived signed URLs via /api/resources/:id/view

# RBAC Initial Admin Accounts (Comma-separated emails synced to PostgreSQL role='ADMIN')
ADMIN_EMAILS="admin@fuoye.edu.ng"

# Optional Distributed Redis Rate Limiter (Upstash REST API — offloads rate-limit writes from PostgreSQL)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Optional PostgreSQL Pool & Query Safety Tuning
PG_POOL_MAX="10"
PG_STATEMENT_TIMEOUT_MS="8000"
PG_QUERY_TIMEOUT_MS="10000"
