// This is your Prisma schema file for NuesaPedia
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String          @id @default(uuid())
  name           String
  email          String          @unique
  password       String
  department     String
  level          String          @default("100L")
  avatar         String
  role           String          @default("STUDENT") // STUDENT, MODERATOR, ADMIN
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  savedResources SavedResource[]
  submissions    Submission[]

  @@map("users")
}

model SavedResource {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  resourceId String   @map("resource_id")
  title      String
  courseCode String   @map("course_code")
  department String
  type       String   @default("PDF")
  fileSize   String   @default("8.4 MB") @map("file_size")
  createdAt  DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, resourceId])
  @@index([userId])
  @@map("saved_resources")
}

model Submission {
  id                 String    @id @default(uuid())
  userId             String    @map("user_id")
  title              String
  courseCode         String    @map("course_code")
  department         String
  level              String
  semester           String    @default("First Semester")
  type               String    @default("Lecture Note")
  medium             String    @default("PDF") // PDF, YOUTUBE
  description        String?
  fileUrl            String?   @map("file_url")
  fileName           String?   @map("file_name")
  fileSize           String?   @map("file_size")
  r2Key              String?   @map("r2_key")
  cloudinaryPublicId String?   @map("cloudinary_public_id")
  youtubeUrl         String?   @map("youtube_url")
  youtubeVideoId     String?   @map("youtube_video_id")
  thumbnailUrl       String?   @map("thumbnail_url")
  status             String    @default("PENDING_REVIEW") // PENDING_REVIEW, APPROVED, REJECTED
  rejectionReason    String?   @map("rejection_reason")
  reviewedAt         DateTime? @map("reviewed_at")
  reviewedBy         String?   @map("reviewed_by")
  createdAt          DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([department])
  @@index([courseCode])
  @@index([userId])
  @@map("submissions")
}
